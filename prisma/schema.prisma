
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


enum Role {
  Admin
  Company
}


model User {
  id          String   @id @default(uuid())
  email       String   @unique
  username    String   @unique
  password    String
  companyName String
  location    String
  role        Role     @default(Company) 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}